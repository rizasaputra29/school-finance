// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String             @id @default(cuid())
  kodeAkun          String             @unique
  namaAkun          String
  tipeAkun          String // Asset, Liability, Equity, Revenue, Expense
  kategori          String? // Bank, Kas, etc. for asset categorization
  saldo             Float              @default(0)
  isSystem          Boolean            @default(false) // System account (protected from deletion/type change)
  isContra          Boolean            @default(false) // Contra account (e.g., Akumulasi Penyusutan)
  normalBalance     String             @default("debit") // 'debit' | 'kredit' - normal balance direction
  isSystemProtected Boolean            @default(false) // System account protection (legacy, use isSystem)
  allowNegative     Boolean            @default(false) // Allow negative balance override
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  cashflows         Cashflow[]
  assets            Asset[]
  debts             Debt[]
  journalEntryLines JournalEntryLine[]

  @@index([tipeAkun])
  @@index([kategori])
  @@index([isSystem])
  @@index([normalBalance])
}

model Student {
  id           String        @id @default(cuid())
  nis          String        @unique
  nama         String
  jenisKelamin String? // L/P
  kelas        String
  tahunMasuk   Int
  tahunAjaran  String?
  namaOrtu     String?
  noTelp       String?
  statusBayar  String // Lunas, Belum Lunas
  status       String        @default("Active") // Active, Inactive
  totalTagihan Float         @default(0)
  totalBayar   Float         @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  billings     Billing[]
  installments Installment[]

  @@index([kelas])
  @@index([statusBayar])
  @@index([status])
  @@index([kelas, statusBayar])
  @@index([status, statusBayar])
}

model Billing {
  id             String        @id @default(cuid())
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  jenisBiaya     String // SPP, Uang Pangkal, Seragam, Buku
  periodeBulan   String // Format: YYYY-MM
  jumlah         Float
  statusBayar    String        @default("Belum Lunas") // Lunas, Belum Lunas
  tanggalBayar   DateTime?
  catatan        String?
  cashflowId     String?       @unique
  cashflow       Cashflow?     @relation(fields: [cashflowId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  installments   Installment[]

  @@unique([studentId, jenisBiaya, periodeBulan])
  @@index([studentId])
  @@index([academicYearId])
  @@index([statusBayar])
  @@index([jenisBiaya])
  @@index([periodeBulan])
  @@index([studentId, statusBayar])
  @@index([studentId, jenisBiaya])
  @@index([academicYearId, statusBayar])
}

model Cashflow {
  id          String   @id @default(cuid())
  version     Int      @default(1) // Optimistic locking
  tanggal     DateTime
  keterangan  String
  kodeAkun    String
  account     Account  @relation(fields: [kodeAkun], references: [kodeAkun], onDelete: Cascade)
  kategori    String?
  debit       Float    @default(0)
  kredit      Float    @default(0)
  source      String? // 'kas' | 'bank' - source of funds
  referenceId String? // Link to billing_id (optional backwards link, but relation is on Billing)
  billing     Billing?
  status      String   @default("draft") // draft, approved, posted
  periode     String? // Format: YYYY-MM for period tracking
  isReversed  Boolean  @default(false) // Soft delete / reversal
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tanggal])
  @@index([kodeAkun])
  @@index([periode])
  @@index([status])
  @@index([kodeAkun, tanggal])
  @@index([tanggal, status])
  @@index([periode, status])
}

// Asset Model - For fixed assets tracking
model Asset {
  id               String   @id @default(cuid())
  kodeAkun         String
  account          Account  @relation(fields: [kodeAkun], references: [kodeAkun], onDelete: Cascade)
  nama             String
  kategori         String // Peralatan, Kendaraan, Bangunan, Tanah
  lokasi           String?
  tanggalPerolehan DateTime
  hargaPerolehan   Float
  umurTeknis       Int // in years: 5, 10, or custom
  nilaiResidu      Float    @default(0)
  isTanah          Boolean  @default(false) // Tanah tidak disusutkan
  status           String   @default("Active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([kodeAkun])
  @@index([kategori])
  @@index([status])
}

// Debt (Hutang) Model - For tracking liabilities/debts
model Debt {
  id                String   @id @default(cuid())
  kodeAkun          String
  account           Account  @relation(fields: [kodeAkun], references: [kodeAkun], onDelete: Cascade)
  nama              String
  kreditur          String?
  jumlahAwal        Float
  jumlahSisa        Float
  tenor             Int // bulan
  tanggalMulai      DateTime
  tanggalJatuhTempo DateTime
  cicilanPerBulan   Float
  status            String   @default("Aktif") // Aktif, Lunas
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([kodeAkun])
  @@index([status])
  @@index([tanggalJatuhTempo])
}

// Installment (Cicilan) Model - For student payment installments
model Installment {
  id                String    @id @default(cuid())
  studentId         String
  student           Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  billingId         String?
  billing           Billing?  @relation(fields: [billingId], references: [id], onDelete: SetNull)
  cicilanKe         Int
  jumlah            Float
  tanggalJatuhTempo DateTime
  tanggalBayar      DateTime?
  status            String    @default("Belum Bayar") // Belum Bayar, Bayar, Jatuh Tempo
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([studentId])
  @@index([billingId])
  @@index([status])
  @@index([tanggalJatuhTempo])
  @@index([studentId, status])
  @@index([billingId, status])
  @@index([tanggalJatuhTempo, status])
}

// AcademicYear (Tahun Ajaran) Model
model AcademicYear {
  id             String    @id @default(cuid())
  tahunAjaran    String    @unique // e.g., "2025/2026"
  tanggalMulai   DateTime
  tanggalSelesai DateTime
  isActive       Boolean   @default(false)
  isArchived     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  billings       Billing[]
}

// JournalEntry - For double-entry bookkeeping verification
model JournalEntry {
  id         String    @id @default(cuid())
  tanggal    DateTime
  keterangan String
  reference  String? // link to cashflow/billing/etc
  status     String    @default("draft") // draft, approved, posted
  version    Int       @default(1) // Optimistic locking
  postedAt   DateTime?
  postedBy   String?

  // Backdated entry tracking
  isBackdated    Boolean   @default(false) // Flag for past date entries
  originalPeriod String? // Original period when backdated (YYYY-MM)
  adjustmentType String    @default("regular") // 'regular' | 'adjusting' - type of entry
  backdatedBy    String? // User who created backdated entry
  backdatedAt    DateTime? // When backdated entry was created
  reason         String? // Reason for backdated entry (for adjustments)

  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  entries   JournalEntryLine[]
  payroll   Payroll?

  @@unique([reference])
  @@index([tanggal])
  @@index([status])
  @@index([isBackdated])
}

// JournalEntryLine - Individual debit/credit lines for journal entries
model JournalEntryLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  kodeAkun       String
  account        Account      @relation(fields: [kodeAkun], references: [kodeAkun], onDelete: Cascade)
  debit          Float        @default(0)
  kredit         Float        @default(0)
  version        Int          @default(1) // Optimistic locking

  @@index([kodeAkun])
  @@index([journalEntryId])
}

// Period - For period management (bulan/tahun)
model Period {
  id           String    @id @default(cuid())
  kode         String    @unique // Format: YYYY-MM
  nama         String // e.g., "Januari 2025"
  tahun        Int
  bulan        Int
  status       String    @default("open") // open, closed, archived
  tanggalMulai DateTime
  tanggalAkhir DateTime
  closedAt     DateTime?
  closedBy     String?
  reopenedAt   DateTime?
  reopenedBy   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tahun])
  @@index([bulan])
  @@index([status])
  @@index([tanggalMulai])
  @@index([tanggalAkhir])
}

// Snapshot - For data freeze and reports
model Snapshot {
  id          String   @id @default(cuid())
  periode     String // Format: YYYY-MM
  tipe        String // neraca, labarugi, cashflow
  data        Json // Snapshot of report data
  totalDebit  Float
  totalKredit Float
  createdAt   DateTime @default(now())
  createdBy   String?

  @@unique([periode, tipe])
  @@index([periode])
}

// Notification - For system notifications
model Notification {
  id          String   @id @default(cuid())
  tipe        String // approval_request, piutang_jatuh_tempo, hutang_jatuh_tempo
  judul       String
  pesan       String
  isRead      Boolean  @default(false)
  userId      String?
  referenceId String? // Link to related entity
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([tipe])
}

// Employee (Karyawan) Model
model Employee {
  id           String    @id @default(cuid())
  nip          String    @unique
  nama         String
  jabatan      String // Guru, Staff, Kepala Sekolah, etc.
  jenisKelamin String? // L/P
  noTelp       String?
  alamat       String?
  tanggalMasuk DateTime
  gajiPokok    Float     @default(0)
  status       String    @default("Active") // Active, Inactive
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  payrolls     Payroll[]

  @@index([status])
  @@index([jabatan])
}

// Payroll (Gaji/Tunjangan/Bonus) Model
model Payroll {
  id              String        @id @default(cuid())
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periode         String // YYYY-MM
  jenisPembayaran String // Gaji, Tunjangan, Bonus
  jumlah          Float
  keterangan      String?
  tanggalBayar    DateTime?
  status          String        @default("Belum Bayar") // Belum Bayar, Lunas
  journalEntryId  String?       @unique
  journalEntry    JournalEntry? @relation(fields: [journalEntryId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([employeeId, periode, jenisPembayaran])
  @@index([periode])
  @@index([status])
}

// AuditTrail - For audit logging
model AuditTrail {
  id        String   @id @default(cuid())
  action    String // create, update, delete, approve, post, reopen
  entity    String // cashflow, journal, period, etc.
  entityId  String
  oldData   Json?
  newData   Json?
  userId    String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ============================================================================
// BETTER AUTH MODELS
// ============================================================================

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String?
  emailVerified         Boolean   @default(false)
  image                 String?
  
  // RBAC Fields
  role                  String    @default("user") // owner | admin | user
  department            String?
  
  // Relations
  sessions              Session[]
  accounts              AuthAccount[]
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@index([email])
  @@index([role])
}

model Session {
  id                    String    @id
  userId                String
  token                 String    @unique
  expiresAt             DateTime
  ipAddress             String?
  userAgent             String?
  
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@index([userId])
  @@index([token])
}

model AuthAccount {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id                    String    @id
  identifier            String
  value                 String
  expiresAt             DateTime
  
  createdAt             DateTime  @default(now())
  
  @@index([identifier])
  @@index([expiresAt])
}
