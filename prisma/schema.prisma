generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String             @id @default(cuid())
  kodeAkun          String             @unique
  namaAkun          String
  tipeAkun          String
  kategori          String?
  saldo             Float              @default(0)
  isSystem          Boolean            @default(false)
  isContra          Boolean            @default(false)
  normalBalance     String             @default("debit")
  isSystemProtected Boolean            @default(false)
  allowNegative     Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  assets            Asset[]
  cashflows         Cashflow[]
  debts             Debt[]
  Inventory         Inventory[]
  journalEntryLines JournalEntryLine[]
  accountBalances   AccountBalance[]

  @@index([tipeAkun])
  @@index([kategori])
  @@index([isSystem])
  @@index([normalBalance])
}

model Student {
  id           String        @id @default(cuid())
  nis          String        @unique
  nama         String
  jenisKelamin String?
  kelas        String
  tahunMasuk   Int
  tahunAjaran  String?
  namaOrtu     String?
  noTelp       String?
  statusBayar  String
  status       String        @default("Active")
  totalTagihan Float         @default(0)
  totalBayar   Float         @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  billings     Billing[]
  installments Installment[]

  @@index([kelas])
  @@index([statusBayar])
  @@index([status])
  @@index([kelas, statusBayar])
  @@index([status, statusBayar])
}

model Billing {
  id                  String        @id @default(cuid())
  studentId           String
  academicYearId      String
  jenisBiaya          String
  bulan               Int?
  jumlah              Float
  statusBayar         String        @default("Belum Lunas")
  tanggal             DateTime      @default(now())
  tanggalBayar        DateTime?
  tanggalJatuhTempo   DateTime?
  keterangan          String?
  catatan             String?
  cashflowId          String?       @unique
  isCicilan           Boolean       @default(false)
  tenor               Int?
  cicilanGroupId      String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  academicYear        AcademicYear? @relation(fields: [academicYearId], references: [id])
  cashflow            Cashflow?     @relation(fields: [cashflowId], references: [id], onDelete: Cascade)
  student             Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  installments        Installment[]

  @@unique([studentId, jenisBiaya, academicYearId, bulan])
  @@index([studentId])
  @@index([academicYearId])
  @@index([statusBayar])
  @@index([jenisBiaya])
  @@index([studentId, statusBayar])
  @@index([studentId, jenisBiaya])
  @@index([academicYearId, statusBayar])
  @@index([isCicilan])
  @@index([tanggalJatuhTempo])
  @@index([cicilanGroupId])
}

model Cashflow {
  id               String           @id @default(cuid())
  version          Int              @default(1)
  tanggal          DateTime
  keterangan       String
  kodeAkun         String
  kategori         String?
  cashflowCategory String?          // OPS (Operasi), INV (Investasi), FIN (Pendanaan)
  debit            Float            @default(0)
  kredit           Float            @default(0)
  source           String?
  referenceId      String?
  status           String           @default("draft")
  isReversed       Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  billing          Billing?
  employeeBilling  EmployeeBilling?
  account          Account          @relation(fields: [kodeAkun], references: [kodeAkun], onDelete: Cascade)

  @@index([tanggal])
  @@index([kodeAkun])
  @@index([status])
  @@index([kodeAkun, tanggal])
  @@index([tanggal, status])
  @@index([cashflowCategory])
}

model Asset {
  id                       String   @id @default(cuid())
  kodeAkun                 String
  nama                     String
  kategori                 String
  lokasi                   String?
  tanggalPerolehan         DateTime
  hargaPerolehan           Float
  umurTeknis               Int
  nilaiResidu              Float    @default(0)
  isTanah                  Boolean  @default(false)
  status                   String   @default("Active")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  alreadyDepreciatedAmount Float    @default(0)
  alreadyDepreciatedYears  Int      @default(0)
  sisaUmurTeknis           Int?
  account                  Account  @relation(fields: [kodeAkun], references: [kodeAkun], onDelete: Cascade)

  @@index([kodeAkun])
  @@index([kategori])
  @@index([status])
}

model Debt {
  id                String   @id @default(cuid())
  kodeAkun          String
  nama              String
  kreditur          String?
  jumlahAwal        Float
  jumlahSisa        Float
  tenor             Int
  tanggalMulai      DateTime
  tanggalJatuhTempo DateTime
  cicilanPerBulan   Float
  status            String   @default("Aktif")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  account           Account  @relation(fields: [kodeAkun], references: [kodeAkun], onDelete: Cascade)

  @@index([kodeAkun])
  @@index([status])
  @@index([tanggalJatuhTempo])
}

model Installment {
  id                String    @id @default(cuid())
  studentId         String
  billingId         String?
  cicilanKe         Int
  jumlah            Float
  tanggalJatuhTempo DateTime
  tanggalBayar      DateTime?
  status            String    @default("Belum Bayar")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  billing           Billing?  @relation(fields: [billingId], references: [id])
  student           Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([billingId])
  @@index([status])
  @@index([tanggalJatuhTempo])
  @@index([studentId, status])
  @@index([billingId, status])
  @@index([tanggalJatuhTempo, status])
}

model EmployeeBilling {
  id              String         @id @default(cuid())
  employeeId      String
  academicYearId  String
  jenisBiaya      String
  bulan           Int?
  jumlah          Float
  statusBayar     String         @default("Belum Lunas")
  tanggal         DateTime       @default(now())
  tanggalBayar    DateTime?
  tanggalJatuhTempo DateTime?
  keterangan      String?
  catatan         String?
  cashflowId      String?        @unique
  tipe            String         @default("tagihan")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  academicYear    AcademicYear?  @relation(fields: [academicYearId], references: [id])
  cashflow        Cashflow?      @relation(fields: [cashflowId], references: [id], onDelete: Cascade)
  employee        Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, jenisBiaya, academicYearId, bulan])
  @@index([employeeId])
  @@index([academicYearId])
  @@index([statusBayar])
  @@index([jenisBiaya])
  @@index([employeeId, statusBayar])
  @@index([employeeId, jenisBiaya])
  @@index([academicYearId, statusBayar])
  @@index([tipe])
  @@index([tanggalJatuhTempo])
}



model AcademicYear {
  id               String            @id @default(cuid())
  tahunAjaran      String            @unique
  tanggalMulai     DateTime
  tanggalSelesai   DateTime
  isActive         Boolean           @default(false)
  isArchived       Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  billings         Billing[]
  employeeBillings EmployeeBilling[]
  accountBalances  AccountBalance[]
}

model AccountBalance {
  id             String       @id @default(cuid())
  kodeAkun       String
  academicYearId String
  saldo          Float        @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  account        Account      @relation(fields: [kodeAkun], references: [kodeAkun], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([kodeAkun, academicYearId])
  @@index([academicYearId])
  @@index([kodeAkun])
}

model JournalEntry {
  id             String             @id @default(cuid())
  tanggal        DateTime
  keterangan     String
  reference      String?            @unique
  status         String             @default("draft")
  version        Int                @default(1)
  postedAt       DateTime?
  postedBy       String?
  isBackdated    Boolean            @default(false)
  adjustmentType String             @default("regular")
  backdatedBy    String?
  backdatedAt    DateTime?
  reason         String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  entries        JournalEntryLine[]

  @@index([tanggal])
  @@index([status])
  @@index([isBackdated])
}

model JournalEntryLine {
  id             String       @id @default(cuid())
  journalEntryId String
  kodeAkun       String
  debit          Float        @default(0)
  kredit         Float        @default(0)
  version        Int          @default(1)
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [kodeAkun], references: [kodeAkun], onDelete: Cascade)

  @@index([kodeAkun])
  @@index([journalEntryId])
}

model Snapshot {
  id             String   @id @default(cuid())
  academicYearId String
  tipe           String
  data           Json
  totalDebit     Float
  totalKredit    Float
  createdAt      DateTime @default(now())
  createdBy      String?

  @@unique([academicYearId, tipe])
  @@index([academicYearId])
}

model Notification {
  id          String   @id @default(cuid())
  tipe        String
  judul       String
  pesan       String
  isRead      Boolean  @default(false)
  userId      String?
  referenceId String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([tipe])
}

model Employee {
  id                   String                @id @default(cuid())
  nip                  String                @unique
  nama                 String
  jabatan              String
  jenisKelamin         String?
  noTelp               String?
  alamat               String?
  tanggalMasuk         DateTime
  gajiPokok            Float                 @default(0)
  status               String                @default("Active")
  statusBayar          String                @default("Lunas")
  totalTagihan         Float                 @default(0)
  totalBayar           Float                 @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  employeeBillings     EmployeeBilling[]

  @@index([status])
  @@index([jabatan])
  @@index([statusBayar])
}

model AuditTrail {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  oldData   Json?
  newData   Json?
  userId    String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String?
  emailVerified Boolean       @default(false)
  image         String?
  role          String        @default("user")
  department    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  accounts      AuthAccount[]
  sessions      Session[]

  @@index([email])
  @@index([role])
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model AuthAccount {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identifier])
  @@index([expiresAt])
}

model Inventory {
  id          String   @id @default(cuid())
  kodeAkun    String
  nama        String
  kategori    String
  jumlahAwal  Int
  jumlahSisa  Int
  hargaSatuan Float
  tanggalBeli DateTime
  status      String   @default("Aktif")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  account     Account  @relation(fields: [kodeAkun], references: [kodeAkun], onDelete: Cascade)

  @@index([kategori])
  @@index([kodeAkun])
  @@index([status])
}
