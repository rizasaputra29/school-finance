// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id        String   @id @default(cuid())
  kodeAkun  String   @unique
  namaAkun  String
  tipeAkun  String   // Asset, Liability, Equity, Revenue, Expense
  saldo     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id           String   @id @default(cuid())
  nis          String   @unique
  nama         String
  kelas        String
  tahunMasuk   Int
  statusBayar  String   // Lunas, Belum Lunas
  totalTagihan Float    @default(0)
  totalBayar   Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Cashflow {
  id         String   @id @default(cuid())
  tanggal    DateTime
  keterangan String
  kodeAkun   String
  debit      Float    @default(0)
  kredit     Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
